# Settings for tests/run-font-cache-tests.sh.
# Copy this file to tests/.env (gitignored) and edit it. Variables already set in the
# environment win over this file. Each value is run as a shell command line.

# How to run WP-CLI for the test site. The test adds its own arguments after it.
# Examples: "wp --path=/var/www/html", "ddev wp", "bash /path/to/bin/wp.sh"
WP_CLI="wp"

# Command that empties the object cache the web server uses. Default: $WP_CLI cache flush
# Set it when WP-CLI cannot reach that cache, e.g. Redis in Docker without the PHP extension:
# CACHE_FLUSH="docker compose --project-directory /path/to/site exec -T redis redis-cli flushall"

# Site URL the test requests with curl, WordPress installed at its root. Default: the site's home URL.
# SITE_URL="http://localhost:8080"
